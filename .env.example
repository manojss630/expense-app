# ==============================================================================
# ExpenseApp - Environment Variables
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-long
CORS_ORIGIN=*

# Supabase Database & Auth (Get these from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct PostgreSQL Connection URL (Supabase Project Settings -> Database -> Connection URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# API URLs
NEXT_PUBLIC_API_URL=/api
API_BASE_URL=http://localhost:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api
